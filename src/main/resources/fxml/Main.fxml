<?import com.lolport.CustomJFXToggleButton?>
<AnchorPane prefHeight="663.0" prefWidth="936.0" styleClass="parentPane" stylesheets="@../css/contentBar.css" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.lolport.controller.NavBarController">
    <children>
        <Pane id="navBar" prefHeight="663.0" prefWidth="175.0" styleClass="navBar" stylesheets="@../css/navbar.css">
