                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="36.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="36.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="36.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="36.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="36.0" vgrow="SOMETIMES" />
              </rowConstraints>
               <children>
                  <JFXButton fx:id="homeBtn" maxWidth="1.7976931348623157E308" onAction="#mainPageHandler" prefHeight="45.0" prefWidth="160.0" ripplerFill="TRANSPARENT" styleClass="navItem" stylesheets="@../css/navbar.css" text="  메인페이지">
                     <graphic>
                        <ImageView fx:id="homeImg" fitHeight="16.0" fitWidth="16.0" pickOnBounds="true" preserveRatio="true" />
                     </graphic></JFXButton>
                  <JFXButton fx:id="uploadBtn" maxWidth="1.7976931348623157E308" onAction="#uploadHandler" prefWidth="160.0" ripplerFill="TRANSPARENT" styleClass="navItem" stylesheets="@../css/navbar.css" text="  업로드" GridPane.rowIndex="1">
