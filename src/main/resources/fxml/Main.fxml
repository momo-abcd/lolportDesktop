                        <ImageView fx:id="uploadImg" fitHeight="16.0" fitWidth="16.0" pickOnBounds="true" preserveRatio="true" />
                     </graphic></JFXButton>
                  <JFXButton fx:id="galleryBtn" maxWidth="1.7976931348623157E308" onAction="#galleryHandler" prefWidth="160.0" ripplerFill="TRANSPARENT" styleClass="navItem" stylesheets="@../css/navbar.css" text="  앨범" GridPane.rowIndex="2">
