                     <styleClass>
                        <String fx:value="recording" />
                        <String fx:value="rec" />
                     </styleClass>
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                  </StackPane>
                  <StackPane layoutX="64.0" prefHeight="64.0" prefWidth="52.0" visible="false">
