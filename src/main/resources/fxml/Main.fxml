                  <ImageView fitHeight="35.0" fitWidth="15.0" layoutX="131.0" layoutY="15.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../images/logoRightIcon.png" />
                     </image>
                  </ImageView>
                  <CustomJFXToggleButton fx:id="toggleBtn" layoutY="4.0" styleClass="recordToggle" stylesheets="@../css/navbar.css" text=" " toggleColor="RED" toggleLineColor="#d3a8a8" />
