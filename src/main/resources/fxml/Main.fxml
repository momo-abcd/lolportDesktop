                  <JFXButton fx:id="settingBtn" maxWidth="1.7976931348623157E308" onAction="#settingHandler" prefHeight="44.0" prefWidth="160.0" ripplerFill="TRANSPARENT" styleClass="navItem" stylesheets="@../css/navbar.css" text="  설정" GridPane.rowIndex="4">
                     <graphic>
                        <ImageView fx:id="settingImg" fitHeight="16.0" fitWidth="16.0" pickOnBounds="true" preserveRatio="true" />
                     </graphic></JFXButton>
